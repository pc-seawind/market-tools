     <div class="noindex">
                <div class="left-menu__title menu-title"><h2 id="menuTitlePc" class="data-pc-title">市場通訊</h2><h2 id="menuTitleMobile" class="data-mobile-title">2023</h2><div class="nav-icon" style="height: 48px"><img class="icon-nav" src="/Images/HKEX/HKEX MARKET/menu.png" alt="Navigation Icon"><img class="nav-close" src="/Images/HKEX/HKEX MARKET/CANCEL.png" alt="Navigation Icon"></div></div><div class="left-menu__wrapper"><ul class="left-menu__level1"></ul></div>
