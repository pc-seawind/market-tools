<div class="noindex" id="hkex_market_footer">
    <footer>
        <div class="container">
            <div class="footer__logo">
                <a href="/?sc_lang=en" title="logo_main_white_small"><img src="/-/media/Market-System/logo_main_white_small.png" alt="logo_main_white_small" /></a>
            </div>
